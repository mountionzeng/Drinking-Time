# ════════════════════════════════════════════════════════════════
# 小酌 · 环境变量模板 (.env.example) —— 这份会进 git，只放「字段名」不放真实值
# 用法：复制为 .env（cp .env.example .env），再把真实值填到每个「=」后面
#       .env 已被 .gitignore 忽略，不会进 git，放心填真实密钥
# 改完保存 → 终端 pnpm dev 重启 → 浏览器 Cmd+Shift+R 硬刷新
# ════════════════════════════════════════════════════════════════
#
# ── ① 出卡必填：大模型 Key（聊天记卡片全靠它，缺了 = 永远不出卡）──────
# 服务端拿它打 LLM 生成卡片。来源：你最初拿到的 forge / Manus 平台 key
# （去 Manus 后台「环境变量 / API Key」处，或你自己的备份 / 密码管理器里找）。
BUILT_IN_FORGE_API_KEY=
#
# 下面几条都是【选填】，不确定就留空走默认：
# · API 网关地址，不填默认 https://forge.manus.im
BUILT_IN_FORGE_API_URL=
# · 模型名，不填默认 gemini-2.5-flash
LLM_MODEL=
# · 想让模型「看懂」喂进来的照片就设 true（你的模型支持图片输入时）
LLM_SUPPORTS_IMAGE=true
# · 是否支持结构化 JSON 输出。留空＝true（「强制出卡」的修复要用它），一般别动
LLM_SUPPORTS_RESPONSE_FORMAT=
#
# ── ② 登录 / 云端保存（只有「打不开工作台」或「想云端存」时才补）────────
# 重启后若卡在登录、进不去工作台，再把这几项填上（值同样去 Manus 后台 / 备份找）：
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=
JWT_SECRET=
# 数据库连接串。不填＝本地用内存 / 本地文件兜底（能跑，但清缓存 / 换机可能丢数据）
DATABASE_URL=
# · 本机开发固定访客身份【选填】。设置后所有浏览器 / 无 cookie 请求都解析成
#   这个 openId（如 guest:xxxx），换浏览器或清 cookie 也不会把故事散落到新访客。
#   留空＝每个浏览器独立访客（默认行为）。仅在关闭登录（DISABLE_AUTH）时生效。
DEV_FIXED_GUEST_OPEN_ID=
# 内测账号门槛。默认开启；只有明确准备开放注册时才设为 false。
BETA_INVITE_REQUIRED=true
# Google 登录（现有账号可继续使用，新账号仍受内测门槛限制）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_ORIGIN=http://localhost:3000
# 邮箱验证码发送。生产环境缺少 RESEND_API_KEY 时会明确报错，不会假装已发送。
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# 公开展示在登录页的内测申请微信。建议使用专门的测试联络号，不填则不展示号码。
VITE_BETA_WECHAT_ID=
#
# ── ③ 图片生成（喂图出图，302.ai）─────────────────────────────────
# 去 302.ai 后台「API 管理」处拿 key，复制为 .env 后填到下面「=」后面
API302_KEY=

# ── ③-A 文本/视觉分析算力分流（OpenAI Next，选填）───────────────
# 承接 OpenAI 兼容的文本与多模态 chat/completions；媒体生成、语音和转写仍走 302。
# 配置后优先于对应的 302 文本/视觉分析任务；参考图会发送给该服务处理。
# Key 只放本地 .env，不要提交。
OPENAI_NEXT_API_KEY=
OPENAI_NEXT_BASE_URL=https://api.openai-next.com
OPENAI_NEXT_TEXT_MODEL=gpt-5.6-terra
OPENAI_NEXT_EMOTION_MODEL=deepseek-v3.2
OPENAI_NEXT_VISION_MODEL=qwen3-vl-plus

# · 302.ai 视觉模型【选填】：一键剪辑的「AI 找不一致」（锚点 vs 镜头画面
#   逐对比对五官/发型/服饰/场景/画风）。Key 复用 API302_KEY；
#   留空＝该功能显示配置指引，其余功能不受影响。
VISION_302_MODEL=gemini-3-pro-preview

# ── ④ 图生视频（复用 API302_KEY；默认接 302 MJ-Video 图生视频）──────────
# MJ-Video 提交：POST /mj/submit/video，header: mj-api-secret，body: prompt/motion/image
VIDEO_302_MODEL=mj-video
VIDEO_302_SUBMIT_PATH=/mj/submit/video
VIDEO_302_POLL_PATH=/mj/task/{taskId}/fetch
VIDEO_302_IMAGE_FIELD=image
VIDEO_302_MOTION=low
VIDEO_302_POLL_MS=3000
VIDEO_302_TIMEOUT_MS=300000

# 草稿图快轨：超过这个时间就快速失败，避免“草稿”偷偷变成慢速正式图。
IMAGE_302_DRAFT_TIMEOUT_MS=12000

# ── 个人记忆捕获（U2，Phase 1）──
# 逗号分隔的内部测试账号 userId。**留空 = 谁都不捕获**，这是刻意的默认值：
# 向真实用户开启捕获之前，必须先提供记忆状态说明、暂停后续捕获的开关和
# 清除已采集记录的入口。漏配一次不应该等于对所有人静默开启采集。
PERSONAL_MEMORY_CAPTURE_USER_IDS=

# ── 个人记忆提炼（U5）──
# 逗号分隔，只能是 openai-next 和/或 302。**留空 = 没有任何供应商被批准**，
# 提炼任务永远退避重试、停在 pending，不算失败。进入这个清单前必须先书面
# 确认该供应商的数据留存时长、是否用于训练和数据地域——这是产品/法务决定，
# 不是留空就能绕过的工程细节。
PERSONAL_MEMORY_PROVIDER_ALLOWLIST=

# 单次提炼调用的可信费用上界（元）。不按 token 精算——这套代码库目前没有把
# 逐模型单价接进 textComputeProvider，用保守固定上界代替。默认 ¥0.05。
PERSONAL_MEMORY_EXTRACTION_MAX_COST_YUAN=0.05

# 结算时按 token 用量估算实际花费的单价（元/千 token）。同样是估算，不是
# 精算——好过把「实际成本」永远记成 0。供应商真实计费数据接入后应该替换掉
# 这条估算。默认 ¥0.01/千 token。
PERSONAL_MEMORY_EXTRACTION_COST_PER_1K_TOKENS_YUAN=0.01

# 提炼 runner 的独立 kill switch。true 时启动即暂停：不 claim 任何新任务，
# 但已经 pending 的任务原样留着，不会丢。
PERSONAL_MEMORY_RUNNER_PAUSED=
