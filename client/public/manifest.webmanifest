{
  "id": "/m",
  "name": "拾光",
  "short_name": "拾光",
  "lang": "zh-CN",
  "start_url": "/m",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7f3eb",
  "theme_color": "#f7f3eb",
  "icons": [
    {
      "src": "/share-icons/xiaoyi-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/share-icons/xiaoyi-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/capture-share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "audio/*",
            ".m4a",
            ".mp3",
            ".wav",
            ".ogg",
            ".webm"
          ]
        }
      ]
    }
  }
}
