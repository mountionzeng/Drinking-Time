{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drinking-time:miniprogram-workspace:v1",
  "title": "聊会儿小程序工作区 wire contract",
  "schemaVersion": 1,
  "$defs": {
    "AccountSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "displayName", "maskedEmail"],
      "properties": {
        "contractVersion": { "const": 1 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "maskedEmail": { "type": "string", "minLength": 3, "maxLength": 254 }
      }
    },
    "StorySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "id", "title", "updatedAt"],
      "properties": {
        "contractVersion": { "const": 1 },
        "id": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "integer", "minimum": 0 }
      }
    },
    "StoryCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "clientOperationId", "title"],
      "properties": {
        "contractVersion": { "const": 1 },
        "clientOperationId": { "type": "string", "minLength": 8, "maxLength": 80, "pattern": "^[A-Za-z0-9_-]+$" },
        "title": { "type": "string", "maxLength": 200 }
      }
    },
    "StoryCreateReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "clientOperationId", "requestHash", "status", "story"],
      "properties": {
        "contractVersion": { "const": 1 },
        "clientOperationId": { "type": "string", "minLength": 8, "maxLength": 80 },
        "requestHash": { "type": "string", "pattern": "^scr1-[a-f0-9]{32}$" },
        "status": { "const": "complete" },
        "story": { "$ref": "#/$defs/StorySummary" }
      }
    },
    "StoryCreateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "receipt", "document"],
      "properties": {
        "contractVersion": { "const": 1 },
        "receipt": { "$ref": "#/$defs/StoryCreateReceipt" },
        "document": { "$ref": "#/$defs/DocumentRead" }
      }
    },
    "SubmitTurnRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "storyId", "clientTurnId", "requestHash", "userClientMessageId", "assistantClientMessageId", "userContent"],
      "properties": {
        "contractVersion": { "const": 1 },
        "storyId": { "type": "integer", "minimum": 1 },
        "clientTurnId": { "type": "string", "minLength": 8, "maxLength": 80 },
        "requestHash": { "type": "string", "pattern": "^sct1-[a-f0-9]{32}$" },
        "userClientMessageId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "assistantClientMessageId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "userContent": { "type": "string", "minLength": 1, "maxLength": 20000 }
      }
    },
    "TurnStatusRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "storyId", "clientTurnId", "requestHash"],
      "properties": {
        "contractVersion": { "const": 1 },
        "storyId": { "type": "integer", "minimum": 1 },
        "clientTurnId": { "type": "string", "minLength": 8, "maxLength": 80 },
        "requestHash": { "type": "string", "pattern": "^sct1-[a-f0-9]{32}$" }
      }
    },
    "TurnStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "clientTurnId", "status", "assistantContent", "settledCostMinor"],
      "properties": {
        "contractVersion": { "const": 1 },
        "clientTurnId": { "type": "string", "minLength": 8, "maxLength": 80 },
        "status": { "enum": ["processing", "unknown", "synced", "failed", "rejected"] },
        "assistantContent": { "type": ["string", "null"], "maxLength": 100000 },
        "settledCostMinor": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "TurnReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "clientTurnId", "requestHash", "status", "settledCostMinor"],
      "properties": {
        "contractVersion": { "const": 1 },
        "clientTurnId": { "type": "string", "minLength": 8, "maxLength": 80 },
        "requestHash": { "type": "string", "pattern": "^sct1-[a-f0-9]{32}$" },
        "status": { "enum": ["processing", "unknown", "synced", "failed", "rejected"] },
        "settledCostMinor": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "TurnSubmitResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "turn", "receipt", "balance"],
      "properties": {
        "contractVersion": { "const": 1 },
        "turn": { "$ref": "#/$defs/TurnStatus" },
        "receipt": { "$ref": "#/$defs/TurnReceipt" },
        "balance": { "$ref": "#/$defs/BalanceSummary" }
      }
    },
    "TurnStatusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "turn", "receipt", "balance"],
      "properties": {
        "contractVersion": { "const": 1 },
        "turn": { "$ref": "#/$defs/TurnStatus" },
        "receipt": { "$ref": "#/$defs/TurnReceipt" },
        "balance": { "$ref": "#/$defs/BalanceSummary" }
      }
    },
    "DocumentRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "storyId", "storyRevision", "versionId", "platform", "body", "bodyRevision", "updatedAt"],
      "properties": {
        "contractVersion": { "const": 1 },
        "storyId": { "type": "integer", "minimum": 1 },
        "storyRevision": { "type": "integer", "minimum": 1 },
        "versionId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "platform": { "enum": ["xiaohongshu", "x", "instagram", "linkedin", "wechat_moments", "douyin_tiktok"] },
        "body": { "type": "string", "maxLength": 500000 },
        "bodyRevision": { "type": "integer", "minimum": 1 },
        "updatedAt": { "type": "integer", "minimum": 0 }
      }
    },
    "DocumentSaveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "storyId", "versionId", "platform", "baseBodyRevision", "body"],
      "properties": {
        "contractVersion": { "const": 1 },
        "storyId": { "type": "integer", "minimum": 1 },
        "versionId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "platform": { "enum": ["xiaohongshu", "x", "instagram", "linkedin", "wechat_moments", "douyin_tiktok"] },
        "baseBodyRevision": { "type": "integer", "minimum": 1 },
        "body": { "type": "string", "maxLength": 500000 }
      }
    },
    "DocumentConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "kind", "latest"],
      "properties": {
        "contractVersion": { "const": 1 },
        "kind": { "const": "document-conflict" },
        "latest": { "$ref": "#/$defs/DocumentRead" }
      }
    },
    "DocumentSaveResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "document"],
      "properties": {
        "contractVersion": { "const": 1 },
        "document": { "$ref": "#/$defs/DocumentRead" }
      }
    },
    "BalanceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "currency", "minorPerMajor", "ledgerMinor", "reservedMinor", "availableMinor", "lastSettledCostMinor"],
      "properties": {
        "contractVersion": { "const": 1 },
        "currency": { "const": "CNY" },
        "minorPerMajor": { "const": 1000000 },
        "ledgerMinor": { "type": "integer", "minimum": 0 },
        "reservedMinor": { "type": "integer", "minimum": 0 },
        "availableMinor": { "type": "integer", "minimum": 0 },
        "lastSettledCostMinor": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "RecentCharge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "ledgerEntryId", "storyId", "clientTurnId", "receiptId", "amountMinor", "currency", "minorPerMajor", "settledAt", "label"],
      "properties": {
        "contractVersion": { "const": 1 },
        "ledgerEntryId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "storyId": { "type": "integer", "minimum": 1 },
        "clientTurnId": { "type": ["string", "null"], "maxLength": 80 },
        "receiptId": { "type": ["string", "null"], "maxLength": 80 },
        "amountMinor": { "type": "integer", "minimum": 0 },
        "currency": { "const": "CNY" },
        "minorPerMajor": { "const": 1000000 },
        "settledAt": { "type": "integer", "minimum": 0 },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "ConversationMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "id", "role", "content", "clientMessageId", "createdAt"],
      "properties": {
        "contractVersion": { "const": 1 },
        "id": { "type": "integer", "minimum": 1 },
        "role": { "enum": ["user", "assistant", "system"] },
        "content": { "type": "string", "maxLength": 100000 },
        "clientMessageId": { "type": ["string", "null"], "maxLength": 100 },
        "createdAt": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "WorkspaceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "story", "messages", "document", "balance", "recentCharges"],
      "properties": {
        "contractVersion": { "const": 1 },
        "story": { "$ref": "#/$defs/StorySummary" },
        "messages": { "type": "array", "items": { "$ref": "#/$defs/ConversationMessage" } },
        "document": { "$ref": "#/$defs/DocumentRead" },
        "balance": { "$ref": "#/$defs/BalanceSummary" },
        "recentCharges": { "type": "array", "items": { "$ref": "#/$defs/RecentCharge" } }
      }
    },
    "WorkspaceErrorKind": {
      "enum": ["explicit-failure", "unknown-result", "unauthorized", "identity-conflict", "target-missing", "document-conflict", "insufficient-balance", "content-rejected", "unavailable"]
    },
    "WorkspaceError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "kind", "message", "retryable", "resultUnknown"],
      "properties": {
        "contractVersion": { "const": 1 },
        "kind": { "$ref": "#/$defs/WorkspaceErrorKind" },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "retryable": { "type": "boolean" },
        "resultUnknown": { "type": "boolean" }
      }
    },
    "WorkspaceErrorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "ok", "error"],
      "properties": {
        "contractVersion": { "const": 1 },
        "ok": { "const": false },
        "error": { "$ref": "#/$defs/WorkspaceError" }
      }
    }
  }
}
