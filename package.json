{
  "name": "drinking-time",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "predev": "pkill -f 'server/_core/index.ts' || true; sleep 1",
    "dev": "PORT=3000 NODE_ENV=development tsx watch server/_core/index.ts",
    "env:status": "tsx scripts/env-status.ts",
    "preview:3000": "PORT=3000 NODE_ENV=development tsx watch scripts/preview-server.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "code:health": "tsx scripts/code-health-report.ts",
    "code:health:report": "tsx scripts/code-health-report.ts --out .code-health/static.md --json .code-health/static.json",
    "code:health:snapshot": "tsx scripts/code-health-report.ts --snapshot --out .code-health/latest.md --json .code-health/latest.json",
    "code:health:weekly": "tsx scripts/code-health-report.ts --snapshot --measure-commands --out .code-health/weekly.md --json .code-health/weekly.json",
    "code:health:v8-report": "tsx scripts/code-health-report.ts --coverage .code-health/v8 --out .code-health/runtime.md --json .code-health/runtime.json",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "invite:setup": "tsx scripts/setup-invite-access.ts",
    "invite:create": "tsx scripts/create-invite-code.ts",
    "monitor": "DATABASE_URL=mysql://x knip",
    "eval:prompt": "tsx evals/run.ts",
    "eval:weights": "tsx evals/run-weight-analysis.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "axios": "^1.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "express": "^4.21.2",
    "fast-xml-parser": "5.5.8",
    "framer-motion": "^12.23.22",
    "jose": "6.1.0",
    "lucide-react": "^0.453.0",
    "lunar-javascript": "1.7.7",
    "mysql2": "^3.15.0",
    "nanoid": "^5.1.5",
    "next-themes": "^0.4.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-resizable-panels": "^3.0.6",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "superjson": "^1.13.3",
    "tailwind-merge": "^3.3.1",
    "wouter": "^3.3.5",
    "yaml": "^2.9.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@builder.io/vite-plugin-jsx-loc": "^0.1.1",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.3",
    "@types/express": "4.17.21",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "add": "^2.0.6",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "knip": "^6.17.1",
    "pnpm": "10.18.1",
    "postcss": "^8.4.47",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-manus-runtime": "^0.0.57",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "10.18.1"
  },
  "packageManager": "pnpm@10.18.1",
  "pnpm": {
    "patchedDependencies": {
      "wouter@3.7.1": "patches/wouter@3.7.1.patch"
    },
    "overrides": {
      "tailwindcss>nanoid": "3.3.7"
    }
  }
}
