    "modules": [
      {
        "number": 1,
        "id": "e354b180-74d4-4433-aada-8904a1b2526e",
        "text": "",
        "originalRole": "text"
      },
      {
        "number": 2,
        "id": "a098c8ac-d01b-4a7b-b4db-7887b17ffe91",
        "text": "![图片](/api/images/1793790053487-9f4aa5f8-9ef8-4ebe-b531-8a01c251a9ea.png)",
        "originalRole": "text"
      },
      {
        "number": 3,
        "id": "7376bb77-41e0-4a5e-8806-fda04a8c0342",
        "text": "我们可以接住你的任何细碎的情绪，她们值得被珍视。",
        "originalRole": "dialogue"
      },
      {
        "number": 4,
        "id": "5ca4269d-fd2f-4f57-9f67-b7085b084e57",
        "text": "我们相信再聪明的回应，也替不了你亲自感到的瞬间",
        "originalRole": "dialogue"
      },
      {
        "number": 5,
        "id": "733c4364-f860-4cc4-9d60-14ca5bc6316c",
        "text": "她是你，和这个世界之间的触角。",
        "originalRole": "dialogue"
      },
      {
        "number": 6,
        "id": "dfc9887a-bcaa-4690-b27c-10b663dbd245",
        "text": "你的棱角、犹豫和快乐，都会长成故事。  ",
        "originalRole": "dialogue"
      },
      {
        "number": 7,
        "id": "a90ccef3-3f47-4c75-ae0b-7626aeba7ca0",
        "text": "![图片](/api/images/1793719657524-3527c695-25b3-4f0d-bd54-3e597c5a1ed1.png)",
        "originalRole": "text"
      },
      {
        "number": 8,
        "id": "1f8e9295-8760-4c65-83b5-2a4bc16924f0",
        "text": "![图片](/api/images/1793719685969-6b606dec-bb54-46e2-9577-fcb91d7d4ae9.png)",
        "originalRole": "text"
      },
      {
        "number": 9,
        "id": "270d226a-427d-4ef5-9e1d-34fdac673004",
        "text": "![图片](/api/images/1793719904805-33d17abf-21a2-4546-8503-b2f38ba25a9a.png)",
        "originalRole": "text"
      },
      {
        "number": 10,
        "id": "7e4aaf38-613a-40a2-97a9-f9906987d8a3",
        "text": "鼠标分别点击图一显示出图二，然后扫过图三。",
        "originalRole": "text"
      },
      {
        "number": 11,
        "id": "a1522cb7-9edd-4632-b7f3-1987c3190f9c",
        "text": "鼠标点击音乐，然后显示视频界面",
        "originalRole": "text"
      },
      {
        "number": 12,
        "id": "8d9372f0-244e-4a02-b801-2f549cb3a1c5",
        "text": "长成音乐，长成电影。",
        "originalRole": "dialogue"
      },
      {
        "number": 13,
        "id": "71d1a99c-738a-40b5-b455-f77ffaac3207",
        "text": " 画面停在完整的作品上",
        "originalRole": "dialogue"
      },
      {
        "number": 14,
        "id": "11d0844d-e4ce-4cd2-a87e-23c980a48aaf",
        "text": "它们完完全全属于你。",
        "originalRole": "dialogue"
      },
      {
        "number": 15,
        "id": "0a7b54d0-2228-4944-a168-b94c2b0558d0",
        "text": "不需要任何技巧，真切的表达，最重要。",
        "originalRole": "dialogue"
      },
      {
        "number": 16,
        "id": "84c8160c-adca-450e-a965-1187abb3f0e4",
        "text": "真实的情感，会刺破虚拟世界轻飘飘的表面。",
        "originalRole": "dialogue"
      },
      {
        "number": 17,
        "id": "99aeee4e-522a-41a2-8a64-d97bf3514e31",
        "text": "",
        "originalRole": "dialogue"
      },
      {
        "number": 18,
        "id": "9e178c52-ffe8-4e56-9442-4a8cb4187861",
        "text": "你可以把作品的一部分，送给另一个人。  ",
        "originalRole": "dialogue"
      },
      {
        "number": 19,
        "id": "4da35f10-5962-4cea-a2e3-4a164c298944",
        "text": "它被接住，产生回响，  ",
        "originalRole": "dialogue"
      },
      {
        "number": 20,
        "id": "f1f22c35-8e2e-4f6b-aecc-78073fb0aca1",
        "text": "并在另一个灵魂中长出新的血肉。  ",
        "originalRole": "dialogue"
      },
      {
        "number": 21,
        "id": "e776dc5f-40a1-415a-8c7d-f958c732e01b",
        "text": "于是，你们在同一件作品里相遇。",
        "originalRole": "dialogue"
      },
      {
        "number": 22,
        "id": "5ee7dd3c-1755-4a9a-bc9d-2645fb6a45e2",
        "text": "生生不息。",
        "originalRole": "dialogue"
      },
      {
        "number": 23,
        "id": "165f69f6-b3bb-4828-bd8f-fa13700eb56a",
        "text": "",
        "originalRole": "text"
      }
    ]
  },
