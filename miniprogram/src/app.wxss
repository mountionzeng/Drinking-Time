/**
 * 全局样式基线。
 *
 * 两条硬约束（见交接文档第五节）：
 * 1. 触控目标不小于 44×44px（750rpx 设计宽下 = 88rpx）；
 * 2. 系统字号放大后不能截断关键动作 —— 所以动作按钮一律 min-height + 自动换行，
 *    不用固定 height，也不用 overflow: hidden 裁文字。
 */

page {
  --paper: #fffdf7;
  --paper-raised: #fffefa;
  --ink: #292622;
  --ink-soft: #7a746c;
  --line: #eee7d3;
  --accent: #d4a82b;
  --accent-deep: #aa8120;
  --accent-soft: #faf0d0;
  --warn: #a87926;
  --warn-soft: #fff5dc;
  --ok: #4a6b46;

  background-color: var(--paper);
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

.safe-bottom {
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.safe-top {
  padding-top: calc(16rpx + constant(safe-area-inset-top));
  padding-top: calc(16rpx + env(safe-area-inset-top));
}

.mock-banner {
  display: block;
  box-sizing: border-box;
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 24rpx;
  background-color: rgba(255, 253, 247, 0.92);
  border-bottom: 2rpx solid var(--line);
  color: var(--ink-soft);
  font-size: 22rpx;
}

.mock-banner__badge {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  background-color: var(--accent-soft);
  border-radius: 99rpx;
  color: var(--accent-deep);
  font-size: 20rpx;
  font-weight: 600;
}

.mock-banner__detail {
  flex: 1;
  color: var(--ink-soft);
  font-size: 21rpx;
  line-height: 1.45;
}

.card {
  box-sizing: border-box;
  margin: 24rpx;
  padding: 24rpx;
  background-color: var(--paper-raised);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
}

.action {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  min-width: 88rpx;
  padding: 16rpx 28rpx;
  margin: 0;
  background-color: var(--accent-soft);
  border: 2rpx solid var(--accent);
  border-radius: 18rpx;
  color: var(--accent-deep);
  font-size: 30rpx;
  line-height: 1.4;
  white-space: normal;
  word-break: break-word;
  text-align: center;
}

.action--primary {
  background-color: var(--accent);
  border-color: var(--accent);
  color: #fffdf7;
}

.action--quiet {
  background-color: transparent;
  border-color: var(--line);
  color: var(--ink-soft);
}

.action[disabled] {
  opacity: 0.45;
}

.field-label {
  display: block;
  margin-bottom: 8rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
}

.status-line {
  display: block;
  color: var(--ink-soft);
  font-size: 26rpx;
}

.status-line--warn {
  color: var(--warn);
}
