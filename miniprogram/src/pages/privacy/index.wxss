.page {
  min-height: 100vh;
}

.title {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
}

.version {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
}

.section-title {
  display: block;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.section-body {
  display: block;
  color: var(--ink-soft);
  line-height: 1.7;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
